[Desktop Entry]
Type=Application
Name=Diggr
GenericName=Music Player
Comment=Dig records: previews to want, pass or buy
Exec=diggr %F
Icon=diggr
Terminal=false
Categories=AudioVideo;Audio;Player;
MimeType=audio/mpeg;audio/flac;audio/x-flac;audio/wav;audio/x-wav;audio/ogg;audio/mp4;audio/x-m4a;audio/aac;audio/x-mpegurl;
StartupWMClass=diggr
