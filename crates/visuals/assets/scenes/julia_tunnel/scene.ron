// Julia set seen through a log-polar tunnel, with orbit-trap glow.
// `c` drifts to a new sample-held value every bar; kicks punch the zoom.
(
    name: "Julia Tunnel",
    tags: ["2d", "fractal"],
    kind: Fragment,
    params: [
        (name: "zoom", type: F32, default: [1.0], min: [0.3], max: [4.0]),
        (name: "julia_c", type: Vec2, default: [-0.8, 0.156], min: [-1.2, -1.2], max: [1.2, 1.2]),
        (name: "tunnel", type: F32, default: [0.6], min: [0.0], max: [1.0]),
        (name: "rot_speed", type: F32, default: [0.05], min: [-0.5], max: [0.5]),
        (name: "trap", type: F32, default: [0.3], min: [0.0], max: [1.5]),
        (name: "glow", type: F32, default: [0.6], min: [0.0], max: [3.0]),
        (name: "palette_shift", type: F32, default: [0.0], min: [0.0], max: [1.0]),
        (name: "color_a", type: Color, default: [0.5, 0.5, 0.5], min: [0, 0, 0], max: [1, 1, 1]),
        (name: "color_b", type: Color, default: [0.5, 0.5, 0.5], min: [0, 0, 0], max: [1, 1, 1]),
        (name: "iters", type: Int, default: [64], min: [16], max: [256], mutable: false),
    ],
    macros: [
        (macro: Chaos, param: "julia_c", amount: 0.15),
        (macro: Stretch, param: "tunnel", amount: 0.8),
    ],
    routes: [
        (source: Kick, shapers: [Envelope(attack: Ms(5), release: Ms(120)), Range(0.0, 0.35)], target: "zoom"),
        (source: Const(0), shapers: [Random(Bar), Range(-0.06, 0.06), Smooth(Beats(0.5))], target: "julia_c.x"),
        (source: Const(0), shapers: [Random(Bar), Range(-0.06, 0.06), Smooth(Beats(0.5))], target: "julia_c.y"),
        (source: Bass, shapers: [Smooth(Beats(0.25)), Range(0.0, 0.8)], target: "glow"),
        (source: Hat, shapers: [Envelope(attack: Ms(0), release: Ms(60)), Range(0.0, 0.04)], target: "palette_shift"),
    ],
    optional_routes: [
        (source: Snare, shapers: [Envelope(attack: Ms(0), release: Beats(0.5)), Range(0.0, 0.4)], target: "rot_speed"),
        (source: Tension, shapers: [Range(0.0, 0.3)], target: "trap"),
    ],
    feedback: Some((decay: 0.6, warp: 0.5)),
)
