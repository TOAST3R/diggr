{
  "manifest_version": 3,
  "name": "Diggr bridge",
  "short_name": "Diggr",
  "version": "0.2.2",
  "description": "Bridge music release details from supported online record stores and platforms directly into the Diggr app",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://www.discogs.com/*",
    "https://discogs.com/*",
    "https://*.bandcamp.com/*",
    "https://*.juno.co.uk/*",
    "https://www.beatport.com/*",
    "https://www.traxsource.com/*",
    "https://bleep.com/*",
    "https://*.bleep.com/*",
    "https://www.youtube.com/*",
    "https://soundcloud.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.discogs.com/*",
        "https://discogs.com/*",
        "https://*.bandcamp.com/*"
      ],
      "js": [
        "pages.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.juno.co.uk/*"
      ],
      "js": [
        "pages.js",
        "juno.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.beatport.com/*"
      ],
      "js": [
        "pages.js",
        "beatport.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.traxsource.com/*"
      ],
      "js": [
        "pages.js",
        "traxsource.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://bleep.com/*",
        "https://*.bleep.com/*"
      ],
      "js": [
        "pages.js",
        "bleep.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://soundcloud.com/*"
      ],
      "js": [
        "pages.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Diggr",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
